
<?xml version="1.0" encoding="utf-8"?>

<!--
    AndroidManifest.xml — App2 LocalizacaoGPS
    Projeto: Estação Meteorológica IoT

    Arquivo principal de configuração do aplicativo Android.

    Responsável por:
    - Declarar as permissões de internet e localização.
    - Configurar as propriedades gerais do aplicativo.
    - Registrar a MainActivity.
    - Definir a atividade inicial do aplicativo.

    O App2 obtém a localização do smartphone e publica
    as coordenadas no broker MQTT HiveMQ Cloud.

    O backend recebe essas informações, permitindo que
    o App1 apresente a localização da estação no mapa.
-->

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Permite que o aplicativo acesse a internet.

        Essa permissão é necessária para estabelecer
        conexão com o broker HiveMQ Cloud e publicar
        mensagens MQTT contendo latitude, longitude
        e o registro temporal da localização.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Permissões de localização GPS.

        ACCESS_FINE_LOCATION:
        Permite solicitar a localização precisa do dispositivo,
        utilizando GPS e outras fontes disponíveis.

        ACCESS_COARSE_LOCATION:
        Permite solicitar uma localização aproximada,
        com menor precisão.

        Essas permissões também são verificadas e
        solicitadas durante a execução do aplicativo,
        por meio da MainActivity.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        Configurações gerais do aplicativo Android.

        allowBackup:
        Permite que o sistema realize backup dos dados
        do aplicativo, respeitando as regras configuradas.

        dataExtractionRules:
        Referência às regras de extração e transferência
        de dados utilizadas pelo sistema Android.

        fullBackupContent:
        Define as regras de backup configuradas no projeto.

        icon e roundIcon:
        Referências aos ícones utilizados pelo aplicativo.

        label:
        Nome do aplicativo apresentado ao usuário.

        supportsRtl:
        Habilita suporte a layouts que utilizam
        orientação da direita para a esquerda.

        theme:
        Define o tema visual utilizado pelo aplicativo.
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalizacaoGPS">

        <!--
            MainActivity

            Activity principal do App2.

            Responsável por apresentar a interface
            desenvolvida com Jetpack Compose.

            Nessa tela, o usuário pode solicitar
            uma nova localização GPS e acompanhar
            o estado da publicação MQTT.

            android:exported="true":
            Permite que a Activity seja iniciada
            pelo launcher do sistema Android.

            windowSoftInputMode="adjustResize":
            Configura o ajuste da janela quando
            o teclado virtual é apresentado.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LocalizacaoGPS"
            android:windowSoftInputMode="adjustResize">

            <!--
                Identifica a Activity inicial do aplicativo.

                MAIN:
                Define o ponto de entrada principal.

                LAUNCHER:
                Permite que o aplicativo apareça
                na lista de aplicativos do Android.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>
    </application>

</manifest>
